<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The frame is one bitmap rendered at the widget's exact size. -->
    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Khung ảnh"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="12dp"
        android:text="Đang tải ảnh…"
        android:textColor="#FFFFFF"
        android:shadowColor="#99000000"
        android:shadowRadius="4"
        android:textSize="13sp" />

    <!-- Discreet "next photos" button. -->
    <ImageView
        android:id="@+id/btn_next"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="8dp"
        android:alpha="0.55"
        android:background="@drawable/next_bg"
        android:contentDescription="Ảnh tiếp"
        android:padding="5dp"
        android:src="@drawable/ic_next" />
</FrameLayout>