<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JGamer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
    </style>

    <style name="Theme.JGamer.Fullscreen" parent="Theme.JGamer">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.JGamer.Settings" parent="Theme.Material3.Dark">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>
</resources>
