<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_summary_bg"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cal_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calo"
            android:textColor="#D6FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/cal_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cal_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/ 1725"
            android:textColor="#C2FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="1dp"
        android:layout_height="46dp"
        android:background="#40FFFFFF"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/water_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nước"
            android:textColor="#D6FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/water_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/water_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/ 2000 ml"
            android:textColor="#C2FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="1dp"
        android:layout_height="46dp"
        android:background="#40FFFFFF"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ex_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đốt"
            android:textColor="#D6FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ex_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ex_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="kcal"
            android:textColor="#C2FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
